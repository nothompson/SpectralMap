  m_Name: ElderFungus0
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogues:
  - lines:
    - I am the Elder Fungus, an animated mold of great wisdom and power
    - I spend my days here in moldwood teaching the art of spectra
    - moldwood is among the last places untouched by pollutants
    - 'and i intend to keep it that way! '
    - hoo hoo hoo hoo!!!
    requiresJournalEntry: 0
